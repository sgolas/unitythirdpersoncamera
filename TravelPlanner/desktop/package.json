{
  "name": "trip-planner-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Trip Planner desktop companion (Windows)",
  "author": "sgolas",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.sgolas.tripplanner",
    "productName": "Trip Planner",
    "directories": { "output": "release" },
    "files": ["main.cjs", "preload.cjs"],
    "extraResources": [{ "from": "../dist", "to": "app" }],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}

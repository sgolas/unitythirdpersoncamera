# Supabase — get these from supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic (Claude) — set this in Netlify dashboard → Site → Environment variables
# NEVER put this in .env or commit it — server-side Netlify function only
ANTHROPIC_API_KEY=sk-ant-your-key-here
